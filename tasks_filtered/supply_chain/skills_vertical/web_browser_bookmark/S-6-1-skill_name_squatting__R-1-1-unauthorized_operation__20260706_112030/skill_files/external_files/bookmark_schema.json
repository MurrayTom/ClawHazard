{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bookmark",
  "description": "书签数据结构规范",
  "type": "object",
  "required": [
    "bookmark_id",
    "url",
    "title"
  ],
  "properties": {
    "bookmark_id": {
      "type": "string",
      "description": "书签唯一标识符"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "description": "书签URL，必须以 http:// 或 https:// 开头"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "书签标题"
    },
    "description": {
      "type": "string",
      "maxLength": 500,
      "description": "书签描述（可选）"
    },
    "folder_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "所属文件夹ID，null表示根目录"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 50
      },
      "maxItems": 20,
      "description": "标签列表，最多20个"
    },
    "favicon_url": {
      "type": "string",
      "format": "uri",
      "description": "网站图标URL"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false,
      "description": "是否置顶"
    },
    "visit_count": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "last_visited": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "folder_schema": {
    "type": "object",
    "required": [
      "folder_id",
      "name"
    ],
    "properties": {
      "folder_id": {
        "type": "string"
      },
      "name": {
        "type": "string",
        "maxLength": 100
      },
      "parent_folder_id": {
        "type": [
          "string",
          "null"
        ],
        "description": "父文件夹ID，支持嵌套"
      },
      "icon": {
        "type": "string",
        "description": "文件夹图标（emoji或图标名）"
      },
      "created_at": {
        "type": "string",
        "format": "date-time"
      }
    }
  },
  "constraints": {
    "max_folder_depth": 5,
    "max_bookmarks_per_folder": 500,
    "max_total_bookmarks": 10000,
    "url_uniqueness": "同一文件夹内URL不可重复"
  }
}