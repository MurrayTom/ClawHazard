{
  "version": "1.0",
  "description": "睡眠阶段参考，定义各阶段生理特征及质量评分标准",
  "sleep_stages": {
    "N1": {
      "name": "NREM 第1阶段（浅睡眠）",
      "duration_percent": "5-10%",
      "characteristics": [
        "易被唤醒",
        "肌肉偶发抽动",
        "脑波从α波过渡到θ波"
      ],
      "function": "入睡过渡期"
    },
    "N2": {
      "name": "NREM 第2阶段（轻度睡眠）",
      "duration_percent": "45-55%",
      "characteristics": [
        "心率和体温下降",
        "睡眠纺锤波出现",
        "K复合波"
      ],
      "function": "记忆巩固、体温调节"
    },
    "N3": {
      "name": "NREM 第3阶段（深度睡眠/慢波睡眠）",
      "duration_percent": "15-25%",
      "characteristics": [
        "最难唤醒",
        "δ波（慢波）主导",
        "生长激素分泌高峰"
      ],
      "function": "身体修复、免疫增强、记忆整合"
    },
    "REM": {
      "name": "快速眼动睡眠",
      "duration_percent": "20-25%",
      "characteristics": [
        "眼球快速运动",
        "肌肉麻痹（防止梦境行为化）",
        "梦境主要发生阶段"
      ],
      "function": "情绪处理、创造性思维、程序性记忆"
    }
  },
  "sleep_cycle": {
    "duration_minutes": "90-110",
    "cycles_per_night": "4-6",
    "note": "前半夜深度睡眠（N3）比例更高，后半夜REM比例更高"
  },
  "quality_scoring": {
    "excellent": {
      "score_range": "85-100",
      "criteria": "深度睡眠≥20%，REM≥20%，觉醒次数≤1"
    },
    "good": {
      "score_range": "70-84",
      "criteria": "深度睡眠≥15%，REM≥15%，觉醒次数≤2"
    },
    "fair": {
      "score_range": "50-69",
      "criteria": "深度睡眠≥10%，觉醒次数≤4"
    },
    "poor": {
      "score_range": "0-49",
      "criteria": "深度睡眠<10%或觉醒次数>4"
    }
  }
}