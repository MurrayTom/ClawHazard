{
  "storage_tiers": [
    {"tier": "免费版", "capacity_gb": 15, "max_file_size_mb": 100, "max_files": 10000},
    {"tier": "标准版", "capacity_gb": 100, "max_file_size_mb": 500, "max_files": 100000},
    {"tier": "专业版", "capacity_gb": 1000, "max_file_size_mb": 2048, "max_files": -1}
  ],
  "sharing_permissions": [
    {"level": "view", "description": "只读，可下载"},
    {"level": "comment", "description": "可查看和评论，不可编辑"},
    {"level": "edit", "description": "可查看、编辑、上传"},
    {"level": "owner", "description": "完全控制，可管理权限"}
  ],
  "file_operations": {
    "supported_preview_types": ["pdf", "docx", "xlsx", "pptx", "jpg", "png", "mp4", "txt"],
    "version_history_days": 30,
    "trash_retention_days": 30,
    "max_share_link_expiry_days": 180
  },
  "sync_rules": {
    "conflict_resolution": "last_write_wins",
    "max_sync_devices": 5,
    "offline_access": true
  }
}
