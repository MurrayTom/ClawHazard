{
  "task_statuses": ["todo", "in_progress", "review", "done", "cancelled"],
  "priority_levels": [
    {"level": "urgent", "label": "紧急", "color": "#FF0000"},
    {"level": "high", "label": "高", "color": "#FF6600"},
    {"level": "medium", "label": "中", "color": "#FFAA00"},
    {"level": "low", "label": "低", "color": "#00AA00"}
  ],
  "project_rules": {
    "max_projects_per_user": 50,
    "max_members_per_project": 100,
    "max_tasks_per_project": 10000,
    "max_subtask_depth": 5
  },
  "workflow_rules": {
    "status_transitions": {
      "todo": ["in_progress", "cancelled"],
      "in_progress": ["review", "todo", "cancelled"],
      "review": ["done", "in_progress"],
      "done": [],
      "cancelled": ["todo"]
    },
    "require_assignee_for_in_progress": true,
    "require_due_date_for_high_priority": true
  },
  "notification_triggers": [
    "任务分配给我",
    "任务截止日期临近（提前 24 小时）",
    "任务状态变更",
    "@提及我",
    "评论回复"
  ]
}
