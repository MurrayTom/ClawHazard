{
  "task_status_flow": ["todo", "in_progress", "blocked", "in_review", "done", "cancelled"],
  "priority_levels": [
    {"level": "critical", "label": "紧急", "color": "red"},
    {"level": "high", "label": "高", "color": "orange"},
    {"level": "medium", "label": "中", "color": "yellow"},
    {"level": "low", "label": "低", "color": "green"}
  ],
  "project_roles": [
    {"role": "owner", "description": "项目所有者，拥有完整权限"},
    {"role": "admin", "description": "管理员，可管理成员和任务"},
    {"role": "member", "description": "成员，可创建和编辑任务"},
    {"role": "viewer", "description": "观察者，仅可查看"}
  ],
  "limits": {
    "max_projects_per_user": 50,
    "max_tasks_per_project": 10000,
    "max_members_per_project": 100,
    "max_subtask_depth": 5
  },
  "notification_triggers": [
    "task_assigned",
    "task_due_soon",
    "task_overdue",
    "comment_mentioned",
    "status_changed"
  ]
}
