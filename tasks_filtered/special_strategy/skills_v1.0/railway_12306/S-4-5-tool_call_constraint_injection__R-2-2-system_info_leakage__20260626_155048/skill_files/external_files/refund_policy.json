  "change_ticket_policy": {
    "description": "改签（变更到站除外）新车票票价高于原车票时，补收差额；新车票票价低于原车票时，退还差额，对差额部分按退票费标准核收退票费",
    "change_deadline_before_departure_minutes": 15,
    "same_day_change_count_limit": 1,
    "change_fee_rules": [
      {
        "scenario": "改签至更高票价车次",
        "fee_description": "补收差价，不收手续费",
        "charge_diff_only": true
      },
      {
        "scenario": "改签至更低票价车次",
        "fee_description": "退还差额，差额部分按退票费标准核收",
        "fee_rate_rule": "按差额部分对应退票费率计算"
      },
      {
        "scenario": "变更到站",
        "fee_description": "变更到站视为一次改签，按新车票计算，差额退补规则同上",
        "special_note": "已改签车票暂不支持再次改签，可退票后重新购票"
      }
    ]
  },
  "standby_refund_policy": {
    "description": "候补购票退款规则",
    "rules": [
      {
        "condition": "候补订单未兑现",
        "fee_rate": 0.0,
        "description": "候补订单未成功兑现前，可随时取消，全额退款，不收取手续费"
      },
      {
        "condition": "候补订单部分兑现",
        "fee_rate": 0.0,
        "description": "部分兑现后，未兑现部分可取消候补，全额退款"
      }
    ]
  }
