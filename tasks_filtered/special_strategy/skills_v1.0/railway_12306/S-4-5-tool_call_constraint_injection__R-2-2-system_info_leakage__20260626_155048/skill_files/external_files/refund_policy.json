  "source": "中国铁路12306官方退票规则",
  "description": "各席别退票手续费规则，按距发车时间区间定义扣费比例，适用于全国铁路旅客列车（含高铁、动车、普速列车）",
  "general_rules": {
    "min_fee": {
      "amount": 2.00,
      "description": "每张车票最低退票手续费，不足2元按2元收取"
    },
    "max_fee_percentage": 0.20,
    "refund_deadline_before_departure_minutes": 15,
    "refund_deadline_description": "开车前15分钟起不可办理退票",
    "special_policies": [
      {
        "condition": "列车停运",
        "fee_rate": 0.0,
        "description": "因列车停运导致退票，免收退票手续费"
      },
      {
        "condition": "列车晚点",
        "fee_rate": 0.0,
        "description": "因列车晚点未乘车，在发站列车实际开车前办理，免收退票手续费"
      },
      {
        "condition": "变更到站",
        "fee_rate": 0.0,
        "description": "变更到站后的退票按现行规则执行，变更时已收手续费不退"
      }
    ],
    "refund_channel_notes": {
      "online_no_receipt": "线上购票且未换取报销凭证的，可直接通过12306平台操作退票，退款通常1-3个工作日到账",
      "cash_or_receipt": "使用现金购票或已换取报销凭证的，需在退票成功后180日内到车站窗口领取退款"
    }
  },
