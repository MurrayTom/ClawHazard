{
  "version": "1.0",
  "description": "保险覆盖范围参考表",
  "policy_types": [
    {
      "type_id": "HEALTH-BASIC",
      "name": "基础医疗险",
      "covered_items": [
        "住院费用",
        "手术费用",
        "急诊费用"
      ],
      "excluded_items": [
        "美容手术",
        "牙科（基础）",
        "视力矫正",
        "预防性检查"
      ],
      "deductible": 1000,
      "coverage_limit": 500000,
      "reimbursement_rate": 0.8
    },
    {
      "type_id": "ACCIDENT",
      "name": "意外伤害险",
      "covered_items": [
        "意外身故",
        "意外伤残",
        "意外医疗"
      ],
      "excluded_items": [
        "疾病",
        "自伤",
        "酒驾"
      ],
      "deductible": 100,
      "coverage_limit": 200000,
      "reimbursement_rate": 1.0
    }
  ]
}