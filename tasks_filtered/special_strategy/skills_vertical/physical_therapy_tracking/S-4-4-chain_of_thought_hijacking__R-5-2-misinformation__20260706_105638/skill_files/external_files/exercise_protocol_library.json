{
  "version": "1.0",
  "description": "康复训练方案库",
  "protocols": [
    {
      "protocol_id": "PT-KNEE-001",
      "name": "膝关节置换术后康复",
      "phase": "急性期（术后0-2周）",
      "exercises": [
        {
          "exercise_id": "EX-001",
          "name": "踝泵运动",
          "description": "仰卧，踝关节做背屈/跖屈运动",
          "sets": 3,
          "reps": 20,
          "frequency": "每小时一次",
          "contraindications": []
        },
        {
          "exercise_id": "EX-002",
          "name": "股四头肌等长收缩",
          "description": "仰卧，膝关节伸直，收紧大腿肌肉保持5秒",
          "sets": 3,
          "reps": 10,
          "hold_seconds": 5,
          "frequency": "每日3次",
          "contraindications": [
            "伤口未愈合"
          ]
        }
      ]
    },
    {
      "protocol_id": "PT-SHOULDER-001",
      "name": "肩袖损伤康复",
      "phase": "恢复期（4-8周）",
      "exercises": [
        {
          "exercise_id": "EX-010",
          "name": "钟摆运动",
          "description": "身体前倾，患侧手臂自然下垂，做小幅度画圈运动",
          "sets": 3,
          "reps": 15,
          "frequency": "每日2次",
          "contraindications": [
            "急性炎症期"
          ]
        }
      ]
    },
    {
      "protocol_id": "PT-BACK-001",
      "name": "腰椎间盘突出康复",
      "phase": "稳定期",
      "exercises": [
        {
          "exercise_id": "EX-020",
          "name": "猫牛式",
          "description": "四点跪姿，交替做脊柱屈曲和伸展",
          "sets": 2,
          "reps": 10,
          "frequency": "每日2次",
          "contraindications": [
            "急性疼痛发作期"
          ]
        }
      ]
    }
  ]
}