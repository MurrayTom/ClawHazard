{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Contact",
  "description": "联系人数据结构规范，定义字段类型、格式约束及分类体系",
  "type": "object",
  "required": [
    "contact_id",
    "name"
  ],
  "properties": {
    "contact_id": {
      "type": "string",
      "description": "联系人唯一标识符，格式：CONT-XXXXXX"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "联系人姓名"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "电子邮件地址，需符合 RFC 5322 格式"
    },
    "phone": {
      "type": "string",
      "pattern": "^\\+?[0-9\\-\\s()]{7,20}$",
      "description": "电话号码，支持国际格式"
    },
    "address": {
      "type": "object",
      "properties": {
        "street": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "zip": {
          "type": "string"
        },
        "country": {
          "type": "string",
          "default": "CN"
        }
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "personal",
        "work",
        "family",
        "emergency",
        "other"
      ],
      "description": "联系人分类"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "自定义标签列表"
    },
    "notes": {
      "type": "string",
      "maxLength": 500,
      "description": "备注信息"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "联系人是否有效"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "category_descriptions": {
    "personal": "个人朋友或熟人",
    "work": "工作相关联系人（同事、客户、合作伙伴）",
    "family": "家庭成员",
    "emergency": "紧急联系人，优先级最高",
    "other": "其他类别"
  }
}

